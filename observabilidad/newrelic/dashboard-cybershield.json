            "nrqlQueries": [
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT average(cybershield.eventloop.lag) AS 'medio', max(cybershield.eventloop.lag.max) AS 'máximo' FROM Metric WHERE service.name = 'cybershield' TIMESERIES"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
