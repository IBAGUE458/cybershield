{
  "name": "CyberShield · Rendimiento y observabilidad",
  "description": "Trazas, métricas y logs del servidor de CyberShield enviados con OpenTelemetry.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Rendimiento y observabilidad",
      "description": null,
      "widgets": [
        {
          "title": "Peticiones por minuto",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT rate(count(*), 1 minute) AS 'peticiones/min' FROM Span WHERE service.name = 'cybershield' AND span.kind = 'server' TIMESERIES"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Latencia del servidor p50 / p95 / p99 (ms)",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT percentile(cybershield.http.server.duration, 50, 95, 99) FROM Metric WHERE service.name = 'cybershield' TIMESERIES"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Tasa de errores 5xx (%)",
          "layout": {
            "column": 9,
            "row": 1,
            "width": 2,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT filter(count(cybershield.http.server.duration), WHERE http.response.status_code >= 500) * 100 / count(cybershield.http.server.duration) AS '% errores 5xx' FROM Metric WHERE service.name = 'cybershield'"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Rechazos del limitador (429)",
          "layout": {
            "column": 11,
            "row": 1,
            "width": 2,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT sum(cybershield.http.rate_limited) AS 'peticiones 429' FROM Metric WHERE service.name = 'cybershield'"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Peticiones por ruta y estado",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT count(cybershield.http.server.duration) FROM Metric WHERE service.name = 'cybershield' FACET http.route, http.response.status_code"
