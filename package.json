{
  "name": "cybershield",
  "version": "1.0.0",
  "description": "Escape room educativo de ciberseguridad con batería de 27 tipos de pruebas de software",
  "private": true,
  "scripts": {
    "construir": "node herramientas/construir.js",
    "construir:comprobar": "node herramientas/construir.js --comprobar",
    "snyk:cobertura": "node herramientas/cobertura-snyk.js --minimo 100",
    "start": "node servidor.js 8080",
    "csp": "node herramientas/construir.js",
    "csp:comprobar": "node herramientas/construir.js --comprobar",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"pruebas/*.test.js\"",
    "test:una": "node --test --test-reporter=spec",
    "seguridad:npm": "npm audit",
    "rendimiento:k6": "node rendimiento/ejecutar.js k6 carga",
    "rendimiento:k6:humo": "node rendimiento/ejecutar.js k6 humo",
    "rendimiento:k6:pico": "node rendimiento/ejecutar.js k6 pico",
    "rendimiento:k6:estres": "node rendimiento/ejecutar.js k6 estres",
    "rendimiento:k6:resistencia": "node rendimiento/ejecutar.js k6 resistencia",
    "rendimiento:k6:capacidad": "node rendimiento/ejecutar.js k6 capacidad",
    "rendimiento:jmeter": "node rendimiento/ejecutar.js jmeter 100 60 15",
    "observabilidad:subir": "docker compose -f observabilidad/docker-compose.yml up -d",
    "observabilidad:bajar": "docker compose -f observabilidad/docker-compose.yml down",
    "snyk:dependencias": "snyk test --dev --json-file-output=seguridad/snyk-dependencias.json",
    "snyk:codigo": "snyk code test --json-file-output=seguridad/snyk-codigo.json",
    "snyk:informes": "snyk-to-html -i seguridad/snyk-dependencias.json -o seguridad/snyk-dependencias.html && snyk-to-html -i seguridad/snyk-codigo.json -o seguridad/snyk-codigo.html",
    "snyk:monitor": "snyk monitor --project-name=cybershield",
    "rendimiento:todo": "node rendimiento/ejecutar.js todo",
    "rendimiento:todo:rapido": "node rendimiento/ejecutar.js todo --sin-resistencia",
    "rendimiento:k6:validacion": "node rendimiento/ejecutar.js k6 validacion",
    "rendimiento:jmeter:validacion": "node rendimiento/ejecutar.js jmeter validacion",
    "rendimiento:informe": "node rendimiento/ejecutar.js informe",
    "snyk:informe": "node herramientas/informe-snyk.js",
    "cobertura": "node herramientas/cobertura.js",
    "cobertura:informe": "node herramientas/cobertura.js --sin-pruebas",
    "newrelic:servidor": "node -r ./observabilidad/newrelic/telemetria.js servidor.js 8080",
    "newrelic:k6": "node -r ./observabilidad/newrelic/telemetria.js rendimiento/ejecutar.js k6 carga",
    "newrelic:k6:validacion": "node -r ./observabilidad/newrelic/telemetria.js rendimiento/ejecutar.js k6 validacion",
    "newrelic:verificar": "node observabilidad/newrelic/verificar.js",
    "newrelic:dashboard": "node observabilidad/newrelic/preparar-dashboard.js"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "playwright": "^1.45.0",
    "v8-to-istanbul": "^9.3.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1"
  }
}
